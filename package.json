{
  "name": "nop3-lockr-vault",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:format": "biome ci .",
    "verify": "biome ci . && pnpm test:run && pnpm build",
    "e2e": "ng e2e",
    "e2e:components": "playwright test --config=playwright-ct.config.ts"
  },
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngrx/signals": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.4.1",
    "axe-core": "^4.13.0",
    "jsdom": "^28.0.0",
    "playwright-ng-schematics": "^22.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
