{
  "name": "nop3-lockr-vault",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:format": "biome ci .",
    "verify": "biome ci . && pnpm test:run && pnpm build"
  },
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngrx/signals": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
